# LawMap API Environment Variables

# Database connection (Neon PostgreSQL)
# Get this from your Neon dashboard
DATABASE_URL=postgresql://neondb_owner:password@your-host.neon.tech/neondb?sslmode=require

# Alternative: individual PostgreSQL settings (if not using DATABASE_URL)
# DB_HOST=your-host.neon.tech
# DB_PORT=5432
# DB_USER=neondb_owner
# DB_PASSWORD=your-password
# DB_NAME=neondb
# DB_SSLMODE=require

# Server configuration
PORT=8080
LOG_LEVEL=info

# Example data (optional - only used if DATABASE_URL is not set)
EXAMPLES_FILE=docs/EXAMPLES.graph.jsonl

# Sources configuration (optional)
SOURCES_FILE=configs/sources.example.json
